#!/usr/bin/env python3
"""icm-lint — the machine-checkable slice of the ICM walk test, as code.

Checks one workspace: control plane C1-C8, trust plane T1-T8, ops plane O1.
Trust and ops checks self-skip when their governing file is absent, so a
young workspace is never punished for rungs it has not climbed.

Usage:   icm-lint [WORKSPACE] [--strict]
Exit:    0 clean · 1 any ERROR (with --strict: any finding) · 2 usage
Waivers: .icmlint in the workspace root, lines "skip <ID>" or
         "skip <ID> <path-substring>" — recorded exceptions a reviewer can
         see, not silent ones.

Python 3.8+ stdlib. Check IDs are documented in references/checks.md.
Method: ICM (Van Clief & McDermott, arXiv:2603.16021), via icm-architect.
"""
import datetime, json, re, sys
from pathlib import Path
from urllib.parse import unquote

SKIP_DIRS = {".git", "node_modules", "dist", "coverage", "_private", "__pycache__", ".venv"}
TEXT_EXT = {".md", ".txt", ".json", ".yml", ".yaml", ".toml", ".py", ".sh",
            ".js", ".ts", ".tsx", ".css", ".html", ".env"}
CODE_EXT = {".py", ".js", ".ts", ".tsx", ".go", ".rs", ".java", ".rb",
            ".swift", ".c", ".cpp", ".sh"}
BUILTIN_PATTERNS = [
    ("google-api", r"AIza[0-9A-Za-z_\-]{20,}"), ("openai-key", r"\bsk-[A-Za-z0-9_\-]{16,}"),
    ("github-tok", r"\bgh[pousr]_[A-Za-z0-9]{16,}"), ("aws-key", r"\bAKIA[0-9A-Z]{16}\b"),
    ("slack-tok", r"\bxox[baprs]-[0-9A-Za-z\-]{10,}"),
    ("private-key", r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    ("jwt", r"\beyJ[A-Za-z0-9_\-]{10,}\.eyJ[A-Za-z0-9_\-]{10,}"),
]
DATE_RE = re.compile(r"\d{4}-\d{2}-\d{2}")
PATH_RE = re.compile(r"([\w~$./\-]+\.(?:md|txt|json|csv|ya?ml|toml))")
MAX_SCAN = 10_000_000  # bytes; larger files are skipped with a visible warning
findings, waived, waived_paths = [], set(), set()

def add(sev, check, path, msg):
    p = str(path)
    if check in waived or any(c == check and s in p for c, s in waived_paths):
        add.skipped += 1
        return
    findings.append((sev, check, p, msg))
add.skipped = 0

def files_under(root):
    for p in sorted(root.rglob("*")):
        if p.is_file() and not any(part in SKIP_DIRS for part in p.parts):
            yield p

def read(p):
    return p.read_text(errors="replace")

def uncomment(text):
    return re.sub(r"<!--.*?-->", "", text, flags=re.S)

def section(text, heading):
    m = re.search(rf"^##\s+{re.escape(heading)}\s*$(.*?)(?=^##\s|\Z)", text, re.M | re.S)
    return m.group(1) if m else ""

def md_paths(block):
    return re.findall(r"[\w~$./\-]+\.md", block)

def deny_rule(p):
    return f"Read({p})" if p.startswith("~/") else "Read(./" + re.sub(r"^(?:\./|/)+", "", p) + ")"

# ---- control plane ---------------------------------------------------------

def check_control(ws):
    entry = next((ws / n for n in ("CLAUDE.md", "AGENTS.md") if (ws / n).exists()), None)
    if entry is None:
        add("ERROR", "C1", ws, "no CLAUDE.md or AGENTS.md entry file — an agent cannot orient")
        return None
    entry_text = read(entry)
    n = len(entry_text.splitlines())
    if n > 80:
        add("ERROR", "C1", entry, f"{n} lines — the entry file is absorbing payload; move content to a shelf, leave a pointer")
    elif n > 60:
        add("WARN", "C1", entry, f"{n} lines (target <=60) — trim before it becomes a shelf")
    for name in ("CLAUDE.md", "AGENTS.md"):
        for sub in sorted(ws.rglob(name)):
            if sub.parent != ws and not any(p in SKIP_DIRS for p in sub.parts):
                add("WARN", "C1", sub.parent, "nested workspace — lint it separately; the root lint does not check its entry, LOG, or links")

    by_parent = {}
    for d in sorted(ws.rglob("*")):
        if not d.is_dir() or any(p in SKIP_DIRS for p in d.parts):
            continue
        if re.match(r"^\d{2}_", d.name):
            by_parent.setdefault(d.parent, []).append(d)
        elif re.match(r"^\d+_", d.name):
            add("WARN", "C5", d, "off-convention stage folder — use two-digit NN_name so ordering checks see it")
    for parent, stages in by_parent.items():
        nums = [int(d.name[:2]) for d in stages]
        for x in sorted(set(n for n in nums if nums.count(n) > 1)):
            add("ERROR", "C5", parent, f"duplicate stage number {x:02d} — order is ambiguous")
        expect = list(range(min(nums), min(nums) + len(set(nums))))
        if sorted(set(nums)) != expect:
            add("WARN", "C5", parent, f"stage numbering has gaps: {sorted(set(nums))}")
        for st in stages:
            ctx = st / "CONTEXT.md"
            if not ctx.exists():
                add("ERROR", "C2", st, "numbered working folder has no CONTEXT.md contract")
                continue
            text = read(ctx)
            for h in ("inputs", "process", "outputs", "human check"):
                if not re.search(rf"^##\s+{h}\b", text, re.M | re.I):
                    add("ERROR", "C3", ctx, f"contract is missing its '## {h.capitalize()}' section")
            approx = len(entry_text) + len(text)
            for line in section(text, "Inputs").splitlines():
                line = line.strip()
                if not line.startswith("-") or "*" in line:
                    continue
                m = PATH_RE.search(line)
                if not m or "output/" in m.group(1):
                    continue
                p = ctx.parent / m.group(1)
                if p.exists():
                    approx += p.stat().st_size
                elif "(optional)" not in line:
                    add("ERROR", "C4", ctx, f"input path does not resolve: {m.group(1)} — fix it or mark it (optional)")
            if approx // 4 > 8000:
                add("WARN", "C8", ctx, f"stage context ~{approx // 4} tokens (>8k) — split the stage or push detail into a reference file the contract points at")

    for src in (entry, ws / "CONTEXT.md"):
        if not src.exists():
            continue
        for link in re.findall(r"\]\(([^)\s]+?\.md)(?:#[^)]*)?\)", read(src)):
            if not link.startswith(("http", "/")) and not (src.parent / unquote(link)).exists():
                add("ERROR", "C6", src, f"routing link does not resolve: {link}")
    return entry

def check_log(ws):
    log = ws / "LOG.md"
    if not log.exists():
        add("WARN", "C7", ws, "no LOG.md — sessions have no state file to resume from (rung 1)")
        return
    text = read(log)
    nows = re.findall(r"^##\s+Now\b", text, re.M)
    if not nows:
        add("ERROR", "C7", log, "no '## Now' block — a resuming session has nothing to read first")
    elif len(nows) > 1:
        add("ERROR", "C7", log, f"{len(nows)} '## Now' blocks — keep exactly one; a resuming session cannot tell which is current")
    entries = re.split(r"^##\s+(?=\d{4}-\d{2}-\d{2})", text, flags=re.M)
    if len(entries) < 2:
        add("WARN", "C7", log, "no dated '## YYYY-MM-DD — title' entries yet")
    elif "Next:" not in entries[1]:
        add("ERROR", "C7", log, "newest entry has no 'Next:' line — every session ends with a named next step")
    if len(text.splitlines()) > 400:
        add("WARN", "C7", log, ">400 lines — roll old entries over to logs/YYYY-MM.md")

# ---- trust plane (each check self-skips when its governing file is absent) --

def load_patterns(ws, script_dir):
    for cand in (ws / "tools" / "scrub-patterns.txt", script_dir / "scrub-patterns.txt"):
        if cand.exists():
            out = []
            for line in read(cand).splitlines():
                if not line.strip() or line.startswith("#"):
                    continue
                label, _, pat = line.partition("\t")
                try:
                    out.append((label, re.compile(pat.strip()), cand))
                except re.error as e:
                    add("ERROR", "T2", cand, f"pattern '{label}' does not compile ({e}) — a broken pattern is a silently bypassed check")
            return out, cand
    print("icm-lint: note — no scrub-patterns.txt in tools/; using built-in secret shapes only", file=sys.stderr)
    return [(l, re.compile(p), None) for l, p in BUILTIN_PATTERNS], None

def check_trust(ws, entry, script_dir):
    if (ws / "_private").exists():
        gi = ws / ".gitignore"
        if not gi.exists() or "_private" not in read(gi):
            add("ERROR", "T1", ws, "_private/ exists but is not gitignored — it will be committed")

    pats, patfile = load_patterns(ws, script_dir)
    for f in files_under(ws):
        if f.suffix not in TEXT_EXT or f == patfile or f.name == ".icmlint":
            continue
        if f.stat().st_size > MAX_SCAN:
            add("WARN", "T2", f, f"{f.stat().st_size // 1_000_000}MB — too large for the in-memory secret scan; verify with gitleaks")
            continue
        text = read(f)
        for label, pat, _ in pats:
            if pat.search(text):
                add("ERROR", "T2", f, f"matches secret shape '{label}' — rotate the secret, then scrub git history")

    al = ws / "allowlist.md"
    if al.exists():
        today = datetime.date.today().isoformat()
        for i, line in enumerate(read(al).splitlines(), 1):
            if not line.strip().startswith("|") or set(line.replace("|", "").strip()) <= set("- :"):
                continue
            row = line.strip().strip("|")
            cells = [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", row)]
            if cells and cells[0].lower() in ("domain",):
                continue
            if len(cells) != 4 or not DATE_RE.fullmatch(cells[1]):
                add("ERROR", "T3", al, f"row {i}: need | domain | YYYY-MM-DD | approver | scope |")
                continue
            m = re.search(r"expires:(\d{4}-\d{2}-\d{2})", cells[3])
            if m and "REFUSED" not in cells[3] and m.group(1) < today:
                add("WARN", "T3", al, f"row {i}: '{cells[0]}' clearance expired {m.group(1)} — re-clear or revoke with a new row")

    refused = []
    if entry is not None:
        text = uncomment(read(entry))
        loaded, refused = md_paths(section(text, "Identities loaded")), md_paths(section(text, "Identities REFUSED"))
        for p in sorted(set(loaded) & set(refused)):
            add("ERROR", "T4", entry, f"'{p}' is both loaded and refused")
        for p in loaded:
            f = (ws / p) if not p.startswith("~") else Path(p).expanduser()
            if not f.exists():
                add("ERROR", "T4", entry, f"loaded identity not on disk: {p}")
                continue
            m = re.search(r"^\*\*Read by:\*\*(.+)$", read(f), re.M)
            scope = m.group(1) if m else ""
            if m and "every project" not in scope and ws.name not in scope and str(ws) not in scope:
                add("ERROR", "T4", f, f"Read-by scope omits this workspace ({ws.name}) — scope drift; widen the header or stop loading it")

    for gate in sorted(ws.rglob("GATE.md")):
        if any(p in SKIP_DIRS for p in gate.parts):
            continue
        m = re.search(r'^status:\s*(locked|lifted \d{4}-\d{2}-\d{2} ".+")\s*$', read(gate), re.M)
        if not m:
            add("ERROR", "T5", gate, 'no parseable status line — need `status: locked` or `status: lifted YYYY-MM-DD "owner\'s words"`')
        elif m.group(1) == "locked":
            code = [f for f in files_under(gate.parent) if f.suffix in CODE_EXT and "tools" not in f.parts]
            if code:
                add("ERROR", "T5", gate, f"gate is locked but {len(code)} code file(s) exist under it, e.g. {code[0].name}")

    today = datetime.date.today().isoformat()
    for f in files_under(ws):
        if f.suffix == ".md" and f.stat().st_size <= MAX_SCAN:
            for d in re.findall(r"verify-by:\s*(\d{4}-\d{2}-\d{2})", read(f)):
                if d < today:
                    add("WARN", "T6", f, f"claim baseline expired {d} — re-verify before writing from it")

    sec = ws / "SECURITY.md"
    if sec.exists() and len(read(sec).splitlines()) > 60:
        add("WARN", "T7", sec, "the always-loaded summary is bloating — move payload to allowlist.md or a reference file")

    sets = ws / ".claude" / "settings.local.json"
    if sets.exists() and (refused or (ws / "_private").exists()):
        expected = {deny_rule(p) for p in refused if p}
        if (ws / "_private").exists():
            expected.add("Read(./_private/**)")
        try:
            deny = set(json.loads(read(sets)).get("permissions", {}).get("deny", []))
        except Exception:
            deny = set()
        missing = sorted(expected - deny)
        if missing:
            add("WARN", "T8", sets, f"harness deny rules out of date — run tools/icm-scope --write (missing: {', '.join(missing[:3])})")

# ---- ops plane --------------------------------------------------------------

def check_ops(ws):
    mf = ws / "publish.manifest"
    if not mf.exists():
        return
    for i, line in enumerate(read(mf).splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        kind, _, path = line.partition(" ")
        if kind in ("dir", "file", "readme") and not (ws / path.strip()).exists():
            add("ERROR", "O1", mf, f"line {i}: whitelisted {kind} missing on disk: {path.strip()} — the manifest is a structure contract")

# ---- driver -----------------------------------------------------------------

def main():
    args = [a for a in sys.argv[1:] if a != "--strict"]
    strict = "--strict" in sys.argv
    if len(args) > 1:
        print("usage: icm-lint [WORKSPACE] [--strict]", file=sys.stderr)
        sys.exit(2)
    ws = Path(args[0] if args else ".").resolve()
    if not ws.is_dir():
        print(f"icm-lint: not a directory: {ws}", file=sys.stderr)
        sys.exit(2)
    cfg = ws / ".icmlint"
    if cfg.exists():
        for m in re.finditer(r"^skip\s+(\S+)(?:\s+(\S+))?\s*$", read(cfg), re.M):
            (waived_paths.add((m.group(1), m.group(2))) if m.group(2) else waived.add(m.group(1)))

    entry = check_control(ws)
    check_log(ws)
    check_trust(ws, entry, Path(__file__).resolve().parent)
    check_ops(ws)

    for sev, check, path, msg in sorted(findings, key=lambda f: (f[2], f[1])):
        rel = "." if path == str(ws) else path.replace(str(ws) + "/", "")
        print(f"{sev} {check} {rel} — {msg}")
    errs = sum(1 for f in findings if f[0] == "ERROR")
    print(f"icm-lint: {len(findings)} finding(s) ({errs} errors, {len(findings) - errs} warnings)"
          + (f", {add.skipped} waived by .icmlint" if add.skipped else ""))
    sys.exit(1 if errs or (strict and findings) else 0)

if __name__ == "__main__":
    main()
